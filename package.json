{
  "name": "risk2rescue",
  "version": "2.0.0",
  "description": "Risk2Rescue — AI-Powered Disaster Management, Multi-Hazard GIS Intelligence, and Authority Incident Command System",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:ai": "python ai-service/app.py",
    "start:all": "concurrently -n \"NODE,GEOAI\" -c \"blue,green\" \"node server.js\" \"python ai-service/app.py\"",
    "dev": "node server.js",
    "serve": "node server.js",
    "test": "node server.js --check"
  },
  "keywords": [
    "disaster-management",
    "gis-mapping",
    "leaflet",
    "hazard-intelligence",
    "early-warning",
    "emergency-response",
    "ndrf",
    "teja-command-center"
  ],
  "author": "Teja",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^10.0.5"
  },
  "dependencies": {
    "@flaticon/flaticon-uicons": "^3.3.1",
    "ws": "^8.21.3"
  }
}
