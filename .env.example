# RED ZONE INTELLIGENCE — Environment Configuration
# Copy this file to .env and configure your environment variables.

# Server Port (default: 3000)
PORT=3000

# Node Environment
NODE_ENV=development

# Windy Point Forecast API Key (Optional)
# Get a key from https://api.windy.com/ (Point Forecast API v2)
# If left blank, the platform automatically uses Open-Meteo Live Forecast (free, no key required)
WINDY_API_KEY=



# -------------------------------------------------------------
# ESCALATION ALERT ROUTER (Email Notifications)
# -------------------------------------------------------------
# Lightweight, direct integration with free-tier email providers.
# If neither key is configured, alerts will be logged and spooled to data/alert_dispatches_log.json without failing.
# Resend API Key (https://resend.com)
RESEND_API_KEY=
# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=

# Recipient and Sender addresses for escalation emails
ALERT_RECIPIENT_EMAIL=incident-commander@ap-sdma.gov.in
ALERT_SENDER_EMAIL=alerts@resend.dev

# -------------------------------------------------------------
# SATELLITE HAZARD SIGNAL LAYER (NASA FIRMS & Sentinel Hub)
# -------------------------------------------------------------
# NASA FIRMS VIIRS Active Fire Feed:
# Public South Asia 24h NRT CSV feed is queried automatically without requiring an API key.
# Optional MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/map_key:
NASA_FIRMS_MAP_KEY=

# Sentinel Hub Free-Tier Processing API (Copernicus / Sinergise):
# Server-side flood & surface-water compositing (NDWI evalscript).
# Optional: if left blank, Red Zone Intelligence uses high-fidelity multi-spectral cloud compositing.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

